<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="drawbot">

  <!-- Shared geometry (meters), also loaded by the Python control package. -->
  <xacro:property name="geometry" value="${xacro.load_yaml('$(find drawbot_control)/config/drawbot_geometry.yaml')}"/>
  <xacro:property name="base_x" value="${geometry['base']['x']}"/>
  <xacro:property name="base_y" value="${geometry['base']['y']}"/>
  <xacro:property name="base_z" value="${geometry['base']['thickness']}"/>
  <xacro:property name="pcb_x" value="${geometry['pcb']['x']}"/>
  <xacro:property name="pcb_y" value="${geometry['pcb']['y']}"/>
  <xacro:property name="pcb_z" value="${geometry['pcb']['thickness']}"/>
  <!-- Raise the gantry so joint_pen=0 starts 7.5 mm above the PCB. -->
  <xacro:property name="gantry_raise" value="${geometry['gantry_raise']}"/>
  <xacro:property name="support_size" value="${geometry['support']['size']}"/>

  <xacro:property name="rail_x_len" value="${geometry['rail_x']['length']}"/>
  <xacro:property name="rail_x_w"   value="${geometry['rail_x']['width']}"/>
  <xacro:property name="rail_x_h"   value="${geometry['rail_x']['height']}"/>

  <xacro:property name="beam_y_len" value="${geometry['beam_y']['length']}"/>
  <xacro:property name="beam_y_w"   value="${geometry['beam_y']['width']}"/>
  <xacro:property name="beam_y_h"   value="${geometry['beam_y']['height']}"/>

  <xacro:property name="carriage_size" value="${geometry['carriage']['size']}"/>
  <xacro:property name="pen_r" value="${geometry['pen']['radius']}"/>
  <xacro:property name="pen_l" value="${geometry['pen']['length']}"/>

  <!-- Course -->
  <xacro:property name="x_min" value="${geometry['limits']['x'][0]}"/>
  <xacro:property name="x_max" value="${geometry['limits']['x'][1]}"/>
  
  <xacro:property name="y_min" value="${geometry['limits']['y'][0]}"/>
  <xacro:property name="y_max" value="${geometry['limits']['y'][1]}"/>
  <!-- Tip contact is near -6 mm; allow only 0.5 mm extra compression. -->
  <xacro:property name="z_min" value="${geometry['limits']['z'][0]}"/>
  <xacro:property name="z_max" value="${geometry['limits']['z'][1]}"/>

  <material name="grey"><color rgba="0.45 0.45 0.47 1"/></material>
  <material name="blue"><color rgba="0.12 0.35 0.85 1"/></material>
  <material name="cyan"><color rgba="0.15 0.65 0.85 1"/></material>
  <material name="red"><color rgba="0.85 0.18 0.18 1"/></material>
  <material name="black"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="pcb_green"><color rgba="0.04 0.32 0.16 1"/></material>

  <xacro:macro name="support_column" params="name x y">
    <link name="${name}">
      <visual>
        <geometry><box size="${support_size} ${support_size} ${gantry_raise}"/></geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <geometry><box size="${support_size} ${support_size} ${gantry_raise}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.000003" ixy="0" ixz="0" iyy="0.000003" iyz="0" izz="0.000003"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${base_z + gantry_raise/2}"/>
    </joint>
  </xacro:macro>

  <!-- ========== BASE (fixe, horizontale) ========== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_z/2}"/>
      <geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_z/2}"/>
      <geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.05"/>
    </inertial>
  </link>

  <!-- PCB fixée au plateau supérieur du robot -->
  <link name="pcb_link">
    <visual>
      <origin xyz="0 0 ${base_z + pcb_z/2}"/>
      <geometry><box size="${pcb_x} ${pcb_y} ${pcb_z}"/></geometry>
      <material name="pcb_green"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_z + pcb_z/2}"/>
      <geometry><box size="${pcb_x} ${pcb_y} ${pcb_z}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${base_z + pcb_z/2}"/>
      <mass value="0.12"/>
      <inertia ixx="0.000625" ixy="0" ixz="0" iyy="0.000625" iyz="0" izz="0.00125"/>
    </inertial>
  </link>
  <joint name="pcb_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="pcb_link"/>
  </joint>

  <!-- Colonnes structurelles entre le plateau et les rails relevés -->
  <xacro:support_column name="support_front_left" x="-0.14" y="0.15"/>
  <xacro:support_column name="support_front_right" x="0.14" y="0.15"/>
  <xacro:support_column name="support_back_left" x="-0.14" y="-0.15"/>
  <xacro:support_column name="support_back_right" x="0.14" y="-0.15"/>

  <!-- Rails X fixes (deux barres horizontales selon X, aux bords Y) -->
  <link name="rail_x_pos">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="${rail_x_len} ${rail_x_w} ${rail_x_h}"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><box size="${rail_x_len} ${rail_x_w} ${rail_x_h}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="rail_x_pos_j" type="fixed">
    <parent link="base_link"/>
    <child link="rail_x_pos"/>
    <origin xyz="0 ${base_y/2 - 0.03} ${base_z + rail_x_h/2 + gantry_raise}"/>
  </joint>

  <link name="rail_x_neg">
    <visual>
      <geometry><box size="${rail_x_len} ${rail_x_w} ${rail_x_h}"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><box size="${rail_x_len} ${rail_x_w} ${rail_x_h}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="rail_x_neg_j" type="fixed">
    <parent link="base_link"/>
    <child link="rail_x_neg"/>
    <origin xyz="0 ${-base_y/2 + 0.03} ${base_z + rail_x_h/2 + gantry_raise}"/>
  </joint>

  <!-- ========== JOINT X : poutre Y qui glisse selon X (horizontale) ========== -->
  <joint name="joint_x" type="prismatic">
    <parent link="base_link"/>
    <child link="gantry_y_beam"/>
    <origin xyz="0 0 ${base_z + rail_x_h + beam_y_h/2 + gantry_raise}"/>
    <axis xyz="1 0 0"/>
    <limit lower="${x_min}" upper="${x_max}" effort="80" velocity="0.4"/>
    <dynamics damping="1.0" friction="0.2"/>
  </joint>

  <!-- Poutre du portique : longue selon Y, horizontale -->
  <link name="gantry_y_beam">
    <visual>
      <geometry><box size="${beam_y_w} ${beam_y_len} ${beam_y_h}"/></geometry>
      <material name="cyan"/>
    </visual>
    <collision>
      <geometry><box size="${beam_y_w} ${beam_y_len} ${beam_y_h}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.6"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <!-- ========== JOINT Y : chariot qui glisse sur la poutre selon Y (horizontal) ========== -->
  <joint name="joint_y" type="prismatic">
    <parent link="gantry_y_beam"/>
    <child link="head"/>
    <origin xyz="0 0 ${beam_y_h/2 + carriage_size/2}"/>
    <axis xyz="0 1 0"/>
    <limit lower="${y_min}" upper="${y_max}" effort="80" velocity="0.4"/>
    <dynamics damping="1.0" friction="0.2"/>
  </joint>

  <link name="head">
    <visual>
      <geometry><box size="${carriage_size} ${carriage_size} ${carriage_size}"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry><box size="${carriage_size} ${carriage_size} ${carriage_size}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ========== JOINT Z : stylo vertical ========== -->
  <joint name="joint_pen" type="prismatic">
    <parent link="head"/>
    <child link="pen"/>
    <origin xyz="0 0 ${-carriage_size/2}"/>
    <axis xyz="0 0 1"/>
    <limit lower="${z_min}" upper="${z_max}" effort="15" velocity="0.15"/>
    <dynamics damping="0.5" friction="0.05"/>
  </joint>

  <link name="pen">
    <visual>
      <origin xyz="0 0 ${-pen_l/2}"/>
      <geometry><cylinder radius="${pen_r}" length="${pen_l}"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${-pen_l/2}"/>
      <geometry><cylinder radius="${pen_r}" length="${pen_l}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.04"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <link name="pen_tip">
    <visual>
      <geometry><sphere radius="0.0015"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.0015"/></geometry>
    </collision>
  </link>
  <joint name="pen_tip_joint" type="fixed">
    <parent link="pen"/>
    <child link="pen_tip"/>
    <origin xyz="0 0 ${-pen_l}"/>
  </joint>

  <!-- ros2_control (Gazebo Jetty) -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="joint_x">
      <command_interface name="position">
        <param name="min">${x_min}</param>
        <param name="max">${x_max}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_y">
      <command_interface name="position">
        <param name="min">${y_min}</param>
        <param name="max">${y_max}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_pen">
      <command_interface name="position">
        <param name="min">${z_min}</param>
        <param name="max">${z_max}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find drawbot_control)/config/drawbot_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <gazebo reference="base_link"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="pcb_link"><material>Gazebo/Green</material>
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>
  <gazebo reference="rail_x_pos"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="rail_x_neg"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="gantry_y_beam"><material>Gazebo/SkyBlue</material></gazebo>
  <gazebo reference="head"><material>Gazebo/Red</material></gazebo>
  <gazebo reference="pen"><material>Gazebo/Black</material></gazebo>

  <!-- Friction pour le stylo (simulation contact papier) -->
  <gazebo reference="pen">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>
  <gazebo reference="pen_tip">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

</robot>
