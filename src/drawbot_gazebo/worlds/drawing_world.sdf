<?xml version="1.0"?>
<sdf version="1.10">
  <world name="drawing_world">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" 
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" 
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" 
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" 
            name="gz::sim::systems::Contact"/>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Sol défini localement : aucun model:// externe à télécharger. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Table de travail -->
    <model name="work_table">
      <static>true</static>
      <pose>0 0 0.4 0 0 0</pose>
      <link name="table_link">
        <collision name="collision">
          <geometry>
            <box><size>0.6 0.6 0.02</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.6</mu>
                <mu2>0.6</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.6 0.6 0.02</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.6 0.4 1</ambient>
            <diffuse>0.8 0.6 0.4 1</diffuse>
          </material>
        </visual>
        <!-- Pieds de table -->
        <collision name="leg1"><pose>0.25 0.25 -0.4 0 0 0</pose><geometry><box><size>0.05 0.05 0.8</size></box></geometry></collision>
        <visual name="leg1_vis"><pose>0.25 0.25 -0.4 0 0 0</pose><geometry><box><size>0.05 0.05 0.8</size></box></geometry><material><ambient>0.4 0.3 0.2 1</ambient></material></visual>
        <collision name="leg2"><pose>-0.25 0.25 -0.4 0 0 0</pose><geometry><box><size>0.05 0.05 0.8</size></box></geometry></collision>
        <visual name="leg2_vis"><pose>-0.25 0.25 -0.4 0 0 0</pose><geometry><box><size>0.05 0.05 0.8</size></box></geometry><material><ambient>0.4 0.3 0.2 1</ambient></material></visual>
        <collision name="leg3"><pose>0.25 -0.25 -0.4 0 0 0</pose><geometry><box><size>0.05 0.05 0.8</size></box></geometry></collision>
        <visual name="leg3_vis"><pose>0.25 -0.25 -0.4 0 0 0</pose><geometry><box><size>0.05 0.05 0.8</size></box></geometry><material><ambient>0.4 0.3 0.2 1</ambient></material></visual>
        <collision name="leg4"><pose>-0.25 -0.25 -0.4 0 0 0</pose><geometry><box><size>0.05 0.05 0.8</size></box></geometry></collision>
        <visual name="leg4_vis"><pose>-0.25 -0.25 -0.4 0 0 0</pose><geometry><box><size>0.05 0.05 0.8</size></box></geometry><material><ambient>0.4 0.3 0.2 1</ambient></material></visual>
      </link>
    </model>

    <!-- Surface PCB (papier blanc) -->
    <model name="pcb_board">
      <static>true</static>
      <pose>0 0 0.411 0 0 0</pose>
      <link name="pcb_link">
        <visual name="visual">
          <geometry>
            <box><size>0.25 0.25 0.001</size></box>
          </geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.25 0.25 0.001</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.4</mu><mu2>0.4</mu2></ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

  </world>
</sdf>
